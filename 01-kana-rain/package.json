{
  "name": "kana-rain",
  "version": "1.12.0",
  "private": true,
  "description": "An offline-first kana arcade with three hearts and selectable new-kana difficulty",
  "scripts": {
    "start": "node scripts/serve.cjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:analytics": "node --test tests/analytics.test.mjs tests/analytics-game.test.mjs",
    "test:browser": "node tests/browser.cjs",
    "test:novelty-presentation": "node tests/novelty-presentation.browser.cjs",
    "test:novelty-pace": "node tests/new-kana-pace.browser.cjs",
    "test:improvements": "node tests/improvements.browser.cjs",
    "test:sound-pad": "node tests/sound-pad.browser.cjs",
    "test:katakana-bridge": "node tests/katakana-bridge.browser.cjs",
    "test:journey": "node tests/journey.browser.cjs",
    "test:music": "node tests/music.browser.cjs",
    "test:effects": "node tests/effects.browser.cjs",
    "benchmark:save": "node tests/save-performance.browser.cjs",
    "test:quick-wins": "node tests/quick-wins.browser.cjs",
    "test:update": "node tests/update.browser.cjs",
    "test:storage": "node tests/storage.browser.cjs",
    "test:import": "node tests/import.browser.cjs",
    "test:mixed-version-storage": "node tests/mixed-version-storage.browser.cjs",
    "test:performance": "node --test tests/runtime-performance.test.cjs tests/production-performance.test.cjs",
    "assets": "node scripts/prepare-assets.cjs",
    "build": "node scripts/build.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "sharp": "0.35.4"
  }
}
