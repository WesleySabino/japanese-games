{
  "name": "kana-rain",
  "version": "1.4.1",
  "private": true,
  "description": "An immersive, offline-first kana reading game with progressive rain and difficulty-based hearts",
  "scripts": {
    "start": "node scripts/serve.cjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:analytics": "node --test tests/analytics.test.mjs tests/analytics-game.test.mjs",
    "test:browser": "node tests/browser.cjs",
    "test:novelty-presentation": "node tests/novelty-presentation.browser.cjs",
    "test:novelty-pace": "node tests/new-kana-pace.browser.cjs",
    "test:improvements": "node tests/improvements.browser.cjs",
    "test:performance": "node --test tests/runtime-performance.test.cjs tests/production-performance.test.cjs",
    "assets": "node scripts/prepare-assets.cjs",
    "build": "node scripts/build.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "sharp": "0.35.4"
  }
}
